APP_ENV=production
APP_URL=https://perfilemdia.com.br
APP_TIMEZONE=America/Sao_Paulo
APP_ENCRYPTION_KEY=            # 32 bytes em base64: base64_encode(sodium_crypto_secretbox_keygen())

DB_HOST=localhost
DB_NAME=perfilemdia
DB_USER=
DB_PASS=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=       # 32+ chars [A-Za-z0-9_-]
TELEGRAM_BOT_USERNAME=PerfilEmDiaBot

INSTAGRAM_APP_ID=              # ID do app Instagram (nao e o ID do app Facebook)
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://perfilemdia.com.br/oauth/instagram-callback.php
INSTAGRAM_GRAPH_VERSION=v25.0  # conferir a versao atual na documentacao
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_FALLBACK=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1024

# Legendas pelo OpenRouter, no mesmo esquema do SigTerceiros.
# A foto vai em base64. A chave fica só no .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL_FALLBACK=google/gemini-2.5-flash
OPENROUTER_APP_TITLE="Perfil em Dia"

LIMIT_POSTS_PER_MONTH=30
LIMIT_REGENERATIONS_PER_POST=5
MEDIA_PUBLIC_TTL_HOURS=48

PAYMENT_GATEWAY=asaas
PAYMENT_API_KEY=
PAYMENT_ENV=sandbox
PAYMENT_WEBHOOK_TOKEN=
