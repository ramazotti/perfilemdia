{
    "name": "perfilemdia/app",
    "description": "Perfil em Dia: bot do Telegram que publica a foto real do trabalho no Instagram.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "guzzlehttp/guzzle": "^7.9",
        "monolog/monolog": "^3.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "PerfilEmDia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PerfilEmDia\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php bin/migrate.php"
    },
    "config": {
        "sort-packages": true
    }
}
